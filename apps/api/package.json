{
  "name": "@multa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multa API: Hono + Drizzle + better-auth. Изоляция workspace в middleware.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@multa/core": "workspace:*",
    "@multa/i18n": "workspace:*",
    "better-auth": "1.4.21",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
