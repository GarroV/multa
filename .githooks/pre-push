#!/bin/sh
# Полная проверка перед пушем (issue #143): GitHub Actions не запускается по оплате, и без этой
# проверки в main уезжает непроверенный код. Обойти осознанно: git push --no-verify
#
# Включается вручную: git config core.hooksPath .githooks
# Автоматом при `pnpm install` — НЕЛЬЗЯ: тогда git исполняет скрипты из рабочего дерева при каждой
# обычной операции, и чужая ветка плюс установка зависимостей дают запуск чужого кода.
exec pnpm verify
