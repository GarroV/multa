# Multa — пример переменных окружения. Скопируй в .env и заполни. .env НЕ коммитится.

# --- Postgres (docker-compose) ---
POSTGRES_USER=multa
POSTGRES_PASSWORD=multa_dev_password
POSTGRES_DB=multa
# DATABASE_URL, которым ходит apps/api. В docker-сети host = "postgres", локально = "localhost".
DATABASE_URL=postgres://multa:multa_dev_password@localhost:5432/multa

# --- API ---
API_PORT=3000
# Origin веба для CORS
WEB_ORIGIN=http://localhost:5173

# --- Auth (better-auth: пароль + TOTP; см. docs/03-architecture §Профиль нулевой стоимости) ---
# Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# --- FX-пайплайн (бесплатные источники, без ключей) ---
# ЦБ РФ XML_daily + Frankfurter (ЕЦБ) — тянутся кроном, ключи не нужны.

# --- OpenAI (Спринт 5: vision-фоллбек чеков; НЕ нужен в Спринте 1) ---
# Нужен ключ platform.openai.com (подписка ChatGPT Plus API не даёт).
# OPENAI_API_KEY=

# --- Веб ---
# Origin API для фронта. В деве Vite (5173) и api (3000) на разных портах — нужен абсолютный URL.
# В проде переменную оставляют ПУСТОЙ (apps/web/Dockerfile): фронт и api за одним Caddy, запросы
# идут относительными путями от origin страницы. Пустое значение обязательно валидное — см.
# apps/web/src/lib/authClientOptions.ts (better-auth падает на относительном baseURL).
VITE_API_URL=http://localhost:3000
